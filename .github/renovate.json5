{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [":configMigration", "config:recommended"],

  dependencyDashboard: true,
  labels: ["dependencies"],
  minimumReleaseAge: "5 days",
  schedule: "after 10am and before 7pm every weekday",
  timezone: "Asia/Tokyo",

  // Keep routine patch releases out of PRs. Vulnerability alerts are handled
  // independently by Renovate and remain enabled below.
  packageRules: [
    {
      description: "Ignore non-security patch updates",
      enabled: false,
      matchUpdateTypes: ["patch"],
    },
  ],

  // Use both GitHub Advisory and OSV data so security fixes, including patch
  // releases, are raised even when routine patch updates are disabled.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
  },
}
